{
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/followup",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.supabase.co; connect-src 'self' https://challenges.cloudflare.com; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/work",
      "destination": "/#products",
      "permanent": true
    },
    {
      "source": "/work.html",
      "destination": "/#products",
      "permanent": true
    },
    {
      "source": "/cases",
      "destination": "/#products",
      "permanent": true
    },
    {
      "source": "/ms/work",
      "destination": "/ms/#products",
      "permanent": true
    },
    {
      "source": "/ms/work.html",
      "destination": "/ms/#products",
      "permanent": true
    },
    {
      "source": "/ms/cases",
      "destination": "/ms/#products",
      "permanent": true
    },
    {
      "source": "/build-pdf.py",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/serve.py",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/:file*.pptx",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/:file*.pdf",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/.claude/:path*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/Web/:path*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/.env:file*",
      "destination": "/404.html",
      "permanent": false
    }
  ]
}