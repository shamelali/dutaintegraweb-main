{
  "cleanUrls": true,
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/audit.js": { "maxDuration": 30 },
    "api/cron.js": { "maxDuration": 60 },
    "api/admin.js": { "maxDuration": 15 },
    "api/public.js": { "maxDuration": 10 },
    "api/send-email.js": { "maxDuration": 10 }
  },
  "crons": [
    { "path": "/api/cron/followup", "schedule": "0 9 * * *" },
    { "path": "/api/cron/daily-tasks", "schedule": "0 0 * * *" },
    { "path": "/api/cron/digest", "schedule": "30 0 * * *" },
    { "path": "/api/cron/stale-leads", "schedule": "30 1 * * 1" }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/api/products", "destination": "/api/public?resource=products" },
    { "source": "/api/case-studies", "destination": "/api/public?resource=case-studies" },
    { "source": "/api/report", "destination": "/api/public?resource=report" },
    { "source": "/api/track", "destination": "/api/public?resource=track" },
    { "source": "/api/health", "destination": "/api/public?resource=health" },
    { "source": "/api/slack", "destination": "/api/admin?resource=slack" },
    { "source": "/api/admin/login", "destination": "/api/admin?resource=login" },
    { "source": "/api/admin/leads", "destination": "/api/admin?resource=leads" },
    { "source": "/api/admin/audits", "destination": "/api/admin?resource=audits" },
    { "source": "/api/admin/products", "destination": "/api/admin?resource=products" },
    { "source": "/api/admin/case-studies", "destination": "/api/admin?resource=case-studies" },
    { "source": "/api/cron/followup", "destination": "/api/cron?job=followup" },
    { "source": "/api/cron/daily-tasks", "destination": "/api/cron?job=daily-tasks" },
    { "source": "/api/cron/digest", "destination": "/api/cron?job=digest" },
    { "source": "/api/cron/stale-leads", "destination": "/api/cron?job=stale-leads" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.supabase.co; connect-src 'self' https://challenges.cloudflare.com; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/work",
      "destination": "/#products",
      "permanent": true
    },
    {
      "source": "/work.html",
      "destination": "/#products",
      "permanent": true
    },
    {
      "source": "/ms/work",
      "destination": "/ms/#products",
      "permanent": true
    },
    {
      "source": "/ms/work.html",
      "destination": "/ms/#products",
      "permanent": true
    },
    {
      "source": "/build-pdf.py",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/serve.py",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/:file*.pptx",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/:file*.pdf",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/.claude/:path*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/Web/:path*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/.env:file*",
      "destination": "/404.html",
      "permanent": false
    }
  ]
}