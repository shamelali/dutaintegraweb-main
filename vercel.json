{
  "framework": "vite",
  "installCommand": "cd web-new && npm install",
  "buildCommand": "cd web-new && npm run build",
  "outputDirectory": "web-new/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/send-email", "destination": "/api/gateway" },
    { "source": "/api/quiz", "destination": "/api/gateway" },
    { "source": "/api/case-studies", "destination": "/api/gateway" },
    { "source": "/api/testimonial", "destination": "/api/gateway" },
    { "source": "/api/pdpa-score", "destination": "/api/gateway" },
    { "source": "/api/monthly-digest", "destination": "/api/gateway" },
    { "source": "/api/health", "destination": "/api/gateway" },
    { "source": "/api/stats", "destination": "/api/gateway" },
    { "source": "/api/calculator", "destination": "/api/gateway" },
    { "source": "/admin/enquiries", "destination": "/api/gateway" },
    { "source": "/api/portal/login", "destination": "/api/gateway" },
    { "source": "/api/portal/logout", "destination": "/api/gateway" },
    { "source": "/api/portal/me", "destination": "/api/gateway" },
    { "source": "/api/portal/health", "destination": "/api/gateway" },
    { "source": "/api/portal/tickets/:id", "destination": "/api/gateway" },
    { "source": "/api/portal/tickets", "destination": "/api/gateway" },
    { "source": "/admin/clients/:id/send-digest", "destination": "/api/gateway" },
    { "source": "/admin/clients", "destination": "/api/gateway" },
    { "source": "/api/ops/feed", "destination": "/api/gateway" },
    { "source": "/api/ops/consent", "destination": "/api/gateway" },
    { "source": "/api/ops/events", "destination": "/api/gateway" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/ms", "destination": "/" },
    { "source": "/ms/", "destination": "/" },
    { "source": "/ms/:path+", "destination": "/:path+" }
  ]
}
