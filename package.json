{
  "name": "duta-integra-solutions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "eslint api lib js",
    "lint:fix": "eslint api lib js --fix",
    "format": "prettier --write \"**/*.{js,html,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,html,css,json,md}\"",
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "health": "node scripts/health-check.js",
    "migrate": "echo 'Run supabase/migrations/*.sql in Supabase SQL editor or via supabase CLI'",
    "vercel:check": "python3 -m json.tool vercel.json > /dev/null && echo 'vercel.json OK'"
  },
  "dependencies": {
    "@cline/sdk": "^0.0.82",
    "@supabase/supabase-js": "^2.112.3",
    "resend": "^4.5.2"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "prettier": "^3.4.2"
  }
}
