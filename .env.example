# ============================================================
# Duta Integra Solutions — environment variables
# Copy to .env.local for local API testing (never commit secrets)
# On Vercel: Project → Settings → Environment Variables
# ============================================================

# Required — Resend API key (https://resend.com)
# Free tier: 100 emails/day · 3,000/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (defaults shown)
# Must be a domain verified in Resend, or use onboarding@resend.dev while testing
EMAIL_FROM=Duta Integra Website <noreply@dutaintegra.my>
EMAIL_TO=hello@dutaintegra.my,wasilah@dutaintegra.my
# Set to "false" to skip visitor confirmation emails
EMAIL_AUTOREPLY=true

# Supabase (required for admin panel, audit persistence, products, events)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service-role key — required for product image uploads (bypasses RLS).
# Keep secret; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Cron protection — /api/cron/* accepts Bearer CRON_SECRET
# (Vercel's scheduled calls are authorized automatically via x-vercel-cron)
CRON_SECRET=some-long-random-string

# Ops automation (P0) — the daily crons post to Slack + email the digest.
# Required: SLACK_WEBHOOK_URL (below). Email delivery uses RESEND_API_KEY +
# EMAIL_TO already configured above. No extra setup needed to run them.
#   - 08:00 MYT  /api/cron/daily-tasks  → posts both role checklists to Slack
#   - 08:30 MYT  /api/cron/digest       → yesterday's leads + warm audits + stalled
#   - Mon 09:30  /api/cron/stale-leads   → new/contacted leads idle 7+ days
# New leads are auto-scored (lead_score) and routed (assigned_role = technical
# | operations) by api/_scoring.js. No env vars beyond those above are used.

# Audit API tuning (optional)
AUDIT_RATE_MAX=10
AUDIT_RATE_WINDOW=60000

# Admin panel — multi-user login (JSON array of users)
# Each user: { email, password, name, role }
# role = "technical" (Shamel) or "operations" (Amar)
# IMPORTANT: Change these default passwords immediately in production!
ADMIN_USERS=[{"email":"shamel@dutaintegra.my","password":"CHANGE_ME","name":"Shamel","role":"technical"},{"email":"wasilah@dutaintegra.my","password":"CHANGE_ME","name":"Amar","role":"operations"}]
JWT_SECRET=your-unique-secret-key-here

# CORS — comma-separated allowed origins (exact match). Supports wildcards like https://*.vercel.app
# Defaults to https://dutaintegra.my,https://www.dutaintegra.my — add preview URLs as needed.
ALLOWED_ORIGINS=https://dutaintegra.my,https://www.dutaintegra.my

# Slack sync (required for lead notifications + daily tasks posting)
# Create at: slack.com/apps/manage → Custom Integrations → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXX

# Cloudflare Turnstile (required for contact form bot protection)
# Create at: dash.cloudflare.com → Turnstile → Add site
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Rate limiting overrides (optional)
RATE_LIMIT_MAX=5
RATE_WINDOW=60000
