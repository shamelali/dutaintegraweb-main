# Resend API Key - Get one free at https://resend.com (100 emails/day)
# Add this as an environment variable in your Vercel project settings
RESEND_API_KEY=re_your_api_key_here

# Opik Tracing (LLM Observability)
# Get your API key at https://www.comet.com/opik
# Local OSS: http://localhost:5173/api with workspace "default"
# Cloud: https://www.comet.com/opik/api
OPIK_API_KEY=your_opik_api_key
OPIK_WORKSPACE=default
OPIK_URL_OVERRIDE=http://localhost:5173/api
