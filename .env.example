# ============================================================
# Duta Integra Solutions — environment variables
# Copy to .env.local for local API testing (never commit secrets)
# On Vercel: Project → Settings → Environment Variables
# ============================================================

# Required — Resend API key (https://resend.com)
# Free tier: 100 emails/day · 3,000/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (defaults shown)
# Must be a domain verified in Resend, or use onboarding@resend.dev while testing
EMAIL_FROM=Duta Integra Website <noreply@dutaintegra.my>
EMAIL_TO=hello@dutaintegra.my
# Set to "false" to skip visitor confirmation emails
EMAIL_AUTOREPLY=true

# Optional — Slack webhook URL (https://api.slack.com/messaging/webhooks)
# When set, sends a notification to Slack on each successful form submission
# Add on Vercel: `vercel env add SLACK_WEBHOOK_URL`
# Get your webhook at: https://api.slack.com/messaging/webhooks

# Optional — Turnstile secret key (https://dashboard.cloudflare.com turnstile)
# Get from: Cloudflare Dashboard → Security → Turnstile
# Required if you want bot protection on the contact form
# Add on Vercel: `vercel env add TURNSTILE_SECRET_KEY`
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here 
