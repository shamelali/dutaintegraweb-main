# dutaintegra.my — environment configuration
#
# Copy to `.env` and fill in the values you need. Every variable below is
# optional at boot: the server starts and the site works with none of them
# set. What you lose by leaving one blank is noted in each section.
#
# Storage backend and inbox are resolved per request, not at import time, so
# values can be changed and the server restarted without re-importing modules.

# ── Server ──────────────────────────────────────────────────────────────────
# Bind address and port for `npm start`.
# Defaults: HOST=0.0.0.0, PORT=3000
# HOST=0.0.0.0
# PORT=3000

# Directory served as the static site, relative to the working directory.
# Default: ./Web
# WEB_ROOT=./Web

# VERCEL=1 is automatically set on Vercel deployments. Used by /api/health
# to detect serverless environment and warn about non-durable JSONL storage.
# VERCEL=

# ── Lead capture: where enquiries go ────────────────────────────────────────
#
# Inbox that receives a copy of every contact-form submission. Falls back to
# ADMIN_EMAIL. If BOTH are blank the enquiry is still stored, but no email is
# sent and the response reports { "success": true, "delivered": false }.
# CONTACT_INBOX_EMAIL=hello@dutaintegra.my
# ADMIN_EMAIL=hello@dutaintegra.my

# Sender address on notification emails. Optional.
# EMAIL_FROM=no-reply@dutaintegra.my

# ── Lead capture: storage backend ───────────────────────────────────────────
#
# Resolution lives in server/store.mjs and is strict:
#   both set      -> Supabase Postgres
#   both unset    -> local JSONL in ./data, but only outside NODE_ENV=production
#                    (in production this is a hard error, never a silent fallback)
#   only one set  -> hard error in every environment
#
# On Vercel / any serverless host you MUST set the Supabase pair — the function
# filesystem is not durable, so a JSONL file loses every lead on the next cold
# start.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. Server-side only.
# Never expose it to the browser and never commit it.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Directory holding every JSONL fallback store (clients, tickets, digests,
# ops-events, quiz-audits, case-studies, products). Set by the test runner to a
# temp directory so `npm test` never appends into the files you use locally.
# DATA_DIR=./data

# Override one store path directly; beats DATA_DIR for that file only.
# Default: <DATA_DIR>/enquiries.jsonl
# ENQUIRY_STORE=./data/enquiries.jsonl

# Default: <DATA_DIR>/quiz-audits.jsonl
# QUIZ_STORE=./data/quiz-audits.jsonl

# Default: <DATA_DIR>/testimonials.jsonl
# TESTIMONIAL_STORE=./data/testimonials.jsonl

# ── Lead capture: email provider ────────────────────────────────────────────
#
# Set exactly ONE of these. Whichever is present is used; with none set the
# enquiry is stored but not emailed (as described above).
# RESEND_API_KEY=
# BREVO_API_KEY=
# POSTMARK_SERVER_TOKEN=

# ── Access control ──────────────────────────────────────────────────────────
#
# Comma-separated origins allowed to POST cross-origin to the API. Required
# only when the static site and the API are served from different origins;
# same-origin requests carry no Origin header and are always allowed.
# ALLOWED_ORIGINS=https://dutaintegra.my,https://www.dutaintegra.my

# Protects GET /admin/enquiries (the stored-lead table). Compared in constant
# time; if unset the route always returns 401. Generate with:
#   openssl rand -base64 32
# ADMIN_TOKEN=

# Protects POST /api/monthly-digest via the x-digest-token header. This route
# returns aggregated lead data and is refused unless this is set — an unset
# token is a misconfiguration, not an open door. Generate with:
#   openssl rand -base64 32
# DIGEST_TOKEN=

# ── Free IT audit tool ──────────────────────────────────────────────────────
# Requests allowed per window, and window length in milliseconds.
# Defaults: AUDIT_RATE_MAX=20, AUDIT_RATE_WINDOW=60000
# AUDIT_RATE_MAX=20
# AUDIT_RATE_WINDOW=60000

# ── Unified workspace (Phase 2–4) ──────────────────────────────────────────
# Apply supabase/migrations/202610250001_workspace_phase4.sql before enabling
# assessment persistence, durable portal sessions, proposals and DutaSuite APIs.
# The service-role key and ADMIN_TOKEN are server-side only; never use them in
# VITE_/VITE_PUBLIC_/NEXT_PUBLIC_ variables or frontend code.
# ADMIN_TOKEN is also used by the staff-only /api/workspace/admin/* endpoints.
