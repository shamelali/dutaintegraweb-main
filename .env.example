# ── dutaintegra.my ───────────────────────────────────────────────────────────
# Copy to `.env` (git-ignored) and fill in what you need.
# Nothing here is required to serve the site; the parts that matter are the
# enquiry inbox and the allowed origin.

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=3000
# HOST=0.0.0.0
# Static site root, served at "/". Defaults to ./Web
# WEB_ROOT=./Web
# Append-only JSONL store for inbound enquiries. Defaults to ./data/enquiries.jsonl
# ENQUIRY_STORE=./data/enquiries.jsonl

# ── Inbound enquiries (POST /api/send-email) ─────────────────────────────────
# Every enquiry from the contact form is written to ENQUIRY_STORE first, then
# emailed here. A blank value falls through to ADMIN_EMAIL. If neither is set
# the enquiry is still stored and the response reports `delivered: false`.
CONTACT_INBOX_EMAIL=sales@dutaintegrasolutions.com
# ADMIN_EMAIL=

# The contact form is a different origin from the API when the site is hosted
# separately (e.g. static site on Vercel, API elsewhere). List every origin
# allowed to POST, comma-separated, or the request is rejected with 403.
# If the site and API are served from the same origin this can stay unset.
ALLOWED_ORIGINS=https://dutaintegra.my,https://www.dutaintegra.my

# ── Admin: viewing stored enquiries ──────────────────────────────────────────
# Protects GET /admin/enquiries. Generate one with: openssl rand -base64 32
# If unset the route always returns 401.
# ADMIN_TOKEN=

# ── Email delivery ───────────────────────────────────────────────────────────
# Configure exactly one provider, or leave all unset to store-only.
#   RESEND_API_KEY          → https://resend.com
#   BREVO_API_KEY           → https://brevo.com
#   POSTMARK_SERVER_TOKEN   → https://postmarkapp.com
# RESEND_API_KEY=
# BREVO_API_KEY=
# POSTMARK_SERVER_TOKEN=
# EMAIL_FROM=Duta Integra <no-reply@dutaintegrasolutions.com>
